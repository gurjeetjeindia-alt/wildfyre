{% doc %}
  @prompt
    Create a styled wrapper for the native Judge.me review widget that applies a luxury editorial Dossier-style aesthetic. The block should: include the native Judge.me widget, apply custom CSS to override Judge.me's default styling to match a luxury design (clean sans-serif typography, generous whitespace, thin borders, muted tones, no heavy shadows), use custom fonts (EB Garamond for headings, Inter for body), maintain all native Judge.me functionality (review submission, star ratings, sorting), and be fully responsive. The product_id should be dynamically pulled from the Shopify product object using Liquid ({{ product.id }}).
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  @import url('https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap');

  .dossier-reviews-wrapper-{{ ai_gen_id }} {
    font-family: 'Inter', sans-serif;
    color: #000;
    background: #fff;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-widget {
    font-family: 'Inter', sans-serif !important;
  }

  /* Override Judge.me title styling */
  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-widget__title {
    font-family: 'EB Garamond', serif !important;
    font-size: {{ block.settings.title_size }}px !important;
    font-weight: 600 !important;
    color: #000 !important;
    letter-spacing: -0.02em !important;
    text-transform: none !important;
    margin-bottom: 2rem !important;
  }

  /* Override Judge.me star styling */
  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-widget__summary-stars,
  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-review__stars,
  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-review-widget__stars {
    color: #f59e0b !important;
  }

  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-star {
    color: #f59e0b !important;
  }

  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-star.jdgm--off {
    color: #e5e7eb !important;
  }

  /* Override Judge.me review card styling */
  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-review-card {
    border: 1px solid #e5e7eb !important;
    border-radius: 0 !important;
    padding: 2rem !important;
    margin-bottom: 1rem !important;
    background: #fff !important;
    box-shadow: none !important;
    transition: background 0.2s ease !important;
  }

  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-review-card:hover {
    background: #fafafa !important;
  }

  /* Override Judge.me review header styling */
  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-review__header {
    margin-bottom: 1rem !important;
  }

  /* Override Judge.me reviewer name styling */
  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-review__author {
    font-family: 'Inter', sans-serif !important;
    font-weight: 600 !important;
    color: #000 !important;
    font-size: 1rem !important;
  }

  /* Override Judge.me review body styling */
  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-review__body {
    font-family: 'Inter', sans-serif !important;
    font-size: 0.9375rem !important;
    line-height: 1.6 !important;
    color: #374151 !important;
  }

  /* Override Judge.me review title styling */
  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-review__title {
    font-family: 'EB Garamond', serif !important;
    font-size: 1.125rem !important;
    font-weight: 600 !important;
    color: #000 !important;
    margin-bottom: 0.625rem !important;
  }

  /* Override Judge.me verified badge styling */
  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-review__verified-badge {
    font-size: 0.6875rem !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    color: #2563eb !important;
    border: 1.5px solid #2563eb !important;
    padding: 0.125rem 0.4375rem !important;
    letter-spacing: 0.05em !important;
    border-radius: 2px !important;
    background: transparent !important;
  }

  /* Override Judge.me write review button styling */
  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-write-rev-btn {
    background: #000 !important;
    color: #fff !important;
    border: 2px solid #000 !important;
    font-family: 'Inter', sans-serif !important;
    font-size: 0.875rem !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.12em !important;
    padding: 1rem 1.5rem !important;
    transition: all 0.25s ease !important;
  }

  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-write-rev-btn:hover {
    background: #fff !important;
    color: #000 !important;
  }

  /* Override Judge.me sort dropdown styling */
  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-sort-dropdown {
    font-family: 'Inter', sans-serif !important;
    font-size: 0.9375rem !important;
    color: #000 !important;
    border: 1px solid #e5e7eb !important;
    border-radius: 0 !important;
    background: #fff !important;
  }

  /* Override Judge.me pagination styling */
  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-paginator {
    margin-top: 2rem !important;
  }

  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-paginator__page,
  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-paginator__prev-page,
  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-paginator__next-page {
    font-family: 'Inter', sans-serif !important;
    color: #000 !important;
    border: 1px solid #e5e7eb !important;
    background: #fff !important;
  }

  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-paginator__page.jdgm--active,
  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-paginator__page:hover {
    background: #000 !important;
    color: #fff !important;
  }

  /* Override Judge.me modal styling */
  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-modal {
    font-family: 'Inter', sans-serif !important;
    border-radius: 0 !important;
    border: 1px solid #e5e7eb !important;
  }

  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-modal__title {
    font-family: 'EB Garamond', serif !important;
    font-size: 1.5rem !important;
    font-weight: 600 !important;
    color: #000 !important;
  }

  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-form__label {
    font-family: 'Inter', sans-serif !important;
    font-size: 0.875rem !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.1em !important;
    color: #000 !important;
  }

  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-form__input,
  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-form__textarea {
    font-family: 'Inter', sans-serif !important;
    border: 1px solid #e5e7eb !important;
    border-radius: 0 !important;
    background: #fff !important;
    color: #000 !important;
  }

  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-form__submit-btn {
    background: #000 !important;
    color: #fff !important;
    border: 2px solid #000 !important;
    font-family: 'Inter', sans-serif !important;
    font-size: 0.875rem !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.12em !important;
  }

  .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-form__submit-btn:hover {
    background: #fff !important;
    color: #000 !important;
  }

  /* Mobile responsive */
  @media screen and (max-width: 749px) {
    .dossier-reviews-wrapper-{{ ai_gen_id }} {
      width: 100% !important;
      padding: {{ block.settings.section_padding | times: 0.7 }}px 15px !important;
    }

    .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-widget__title {
      font-size: {{ block.settings.title_size | times: 0.7 }}px !important;
    }

    .dossier-reviews-wrapper-{{ ai_gen_id }} .jdgm-review-card {
      padding: 1.5rem !important;
    }
  }
{% endstyle %}

<div class="dossier-reviews-wrapper-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <!-- Native Judge.me Widget -->
  <div id="judgeme_product_reviews" class="jdgm-widget" data-product-id="{{ product.id }}"></div>
</div>

<!-- Load Judge.me Widget Script -->
<script src="https://cdn.judge.me/widget.js" async></script>
{% schema %}
{
  "name": "Dossier reviews",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Title size",
      "min": 24,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Dossier reviews"
    }
  ]
}
{% endschema %}