    {
      "type": "header",
      "content": "Stars"
    },
    {
      "type": "color",
      "id": "star_fill_color",
      "label": "Star fill",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "star_empty_color",
      "label": "Star empty",
      "default": "#e0e0e0"
    },
    {
      "type": "header",
      "content": "Rating breakdown"
    },
    {
      "type": "color",
      "id": "bar_background",
      "label": "Bar background",
      "default": "#f3f3f3"
    },
    {
      "type": "color",
      "id": "bar_fill_color",
      "label": "Bar fill",
      "default": "#121212"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Background",
      "default": "#121212"
