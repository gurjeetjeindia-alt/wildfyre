      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Headings",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted text",
