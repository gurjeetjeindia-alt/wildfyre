</ai-reviews-dossier-{{ ai_gen_id }}>

<script>
  (function() {
    class AiReviewsDossier{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.productId = this.dataset.productId;
        this.apiToken = this.dataset.apiToken;
        this.shopDomain = this.dataset.shopDomain;
        this.reviews = [];
        this.currentSort = 'recent';
      }

      connectedCallback() {
        this.loadingEl = this.querySelector('[data-loading]');
        this.errorEl = this.querySelector('[data-error]');
        this.emptyEl = this.querySelector('[data-empty]');
        this.summaryEl = this.querySelector('.ai-reviews-summary-{{ ai_gen_id }}');
        this.controlsEl = this.querySelector('.ai-reviews-controls-{{ ai_gen_id }}');
        this.reviewsListEl = this.querySelector('[data-reviews-list]');
        this.sortSelect = this.querySelector('[data-sort-select]');
        this.averageScoreEl = this.querySelector('[data-average-score]');
        this.averageStarsEl = this.querySelector('[data-average-stars]');
        this.reviewCountEl = this.querySelector('[data-review-count]');
        this.breakdownEl = this.querySelector('[data-breakdown]');

        this.sortSelect.addEventListener('change', (e) => {
          this.currentSort = e.target.value;
          this.renderReviews();
        });

        this.fetchReviews();
      }

      async fetchReviews() {
        try {
          const url = `https://judge.me/api/v1/reviews?api_token=${this.apiToken}&shop_domain=${this.shopDomain}&product_id=${this.productId}`;
          const response = await fetch(url);
          
          if (!response.ok) {
            throw new Error('Failed to fetch reviews');
          }

          const data = await response.json();
          this.reviews = data.reviews || [];
          
          this.loadingEl.style.display = 'none';

          if (this.reviews.length === 0) {
            this.emptyEl.style.display = 'block';
          } else {
            this.summaryEl.style.display = 'flex';
            this.controlsEl.style.display = 'flex';
            this.renderSummary();
            this.renderReviews();
          }
        } catch (error) {
          this.loadingEl.style.display = 'none';
          this.errorEl.textContent = 'Unable to load reviews. Please try again later.';
          this.errorEl.style.display = 'block';
        }
      }

      renderSummary() {
        if (this.reviews.length === 0) return;

        const totalRating = this.reviews.reduce((sum, review) => sum + review.rating, 0);
        const averageRating = (totalRating / this.reviews.length).toFixed(1);

        this.averageScoreEl.textContent = averageRating;
        this.averageStarsEl.innerHTML = this.renderStars(parseFloat(averageRating));
        this.reviewCountEl.textContent = `${this.reviews.length} ${this.reviews.length === 1 ? 'review' : 'reviews'}`;

        const breakdown = { 5: 0, 4: 0, 3: 0, 2: 0, 1: 0 };
        this.reviews.forEach(review => {
          breakdown[review.rating]++;
        });

        let breakdownHTML = '';
        for (let i = 5; i >= 1; i--) {
          const count = breakdown[i];
          const percentage = this.reviews.length > 0 ? (count / this.reviews.length) * 100 : 0;
          breakdownHTML += `
            <div class="ai-reviews-breakdown-row-{{ ai_gen_id }}">
              <span class="ai-reviews-breakdown-label-{{ ai_gen_id }}">${i} stars</span>
              <div class="ai-reviews-breakdown-bar-{{ ai_gen_id }}">
                <div class="ai-reviews-breakdown-fill-{{ ai_gen_id }}" style="width: ${percentage}%;"></div>
              </div>
              <span class="ai-reviews-breakdown-count-{{ ai_gen_id }}">${count}</span>
            </div>
          `;
        }
        this.breakdownEl.innerHTML = breakdownHTML;
      }

      renderReviews() {
        const sortedReviews = [...this.reviews];

        if (this.currentSort === 'recent') {
          sortedReviews.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
        } else if (this.currentSort === 'highest') {
          sortedReviews.sort((a, b) => b.rating - a.rating);
        } else if (this.currentSort === 'lowest') {
          sortedReviews.sort((a, b) => a.rating - b.rating);
        }

        this.reviewsListEl.innerHTML = sortedReviews.map(review => this.renderReviewCard(review)).join('');
      }

      renderReviewCard(review) {
        const date = new Date(review.created_at);
        const formattedDate = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
        const verifiedBadge = review.verified === 'yes' ? `
          <div class="ai-reviews-verified-badge-{{ ai_gen_id }}">
            <svg class="ai-reviews-verified-icon-{{ ai_gen_id }}" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M8 0L10.472 5.528L16 8L10.472 10.472L8 16L5.528 10.472L0 8L5.528 5.528L8 0Z" fill="currentColor"/>
            </svg>
            Verified
          </div>
        ` : '';

        return `
          <div class="ai-reviews-card-{{ ai_gen_id }}">
            <div class="ai-reviews-card-header-{{ ai_gen_id }}">
              <div class="ai-reviews-card-meta-{{ ai_gen_id }}">
                <div class="ai-reviews-card-stars-{{ ai_gen_id }}">
                  ${this.renderStars(review.rating)}
                </div>
                <div class="ai-reviews-card-author-{{ ai_gen_id }}">${this.escapeHtml(review.reviewer.name || 'Anonymous')}</div>
                <div class="ai-reviews-card-date-{{ ai_gen_id }}">${formattedDate}</div>
              </div>
              ${verifiedBadge}
            </div>
            ${review.title ? `<h3 class="ai-reviews-card-title-{{ ai_gen_id }}">${this.escapeHtml(review.title)}</h3>` : ''}
            ${review.body ? `<div class="ai-reviews-card-body-{{ ai_gen_id }}">${this.escapeHtml(review.body)}</div>` : ''}
          </div>
        `;
      }

      renderStars(rating) {
        const fullStars = Math.floor(rating);
        const hasHalfStar = rating % 1 >= 0.5;
        const emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);

        let starsHTML = '';

        for (let i = 0; i < fullStars; i++) {
          starsHTML += this.starSVG(true);
        }

        if (hasHalfStar) {
          starsHTML += this.starSVG(true);
        }

        for (let i = 0; i < emptyStars; i++) {
          starsHTML += this.starSVG(false);
        }

        return starsHTML;
      }

      starSVG(filled) {
        const fillColor = filled ? '{{ block.settings.star_color }}' : '{{ block.settings.star_empty_color }}';
        return `
          <svg class="ai-reviews-star-{{ ai_gen_id }}" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M8 0L10.472 5.528L16 8L10.472 10.472L8 16L5.528 10.472L0 8L5.528 5.528L8 0Z" fill="${fillColor}"/>
          </svg>
        `;
      }

      escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      }
    }

    customElements.define('ai-reviews-dossier-{{ ai_gen_id }}', AiReviewsDossier{{ ai_gen_id }});
  })();
</script>

