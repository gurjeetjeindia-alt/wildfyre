{% doc %}
  @prompt
    Build a custom product reviews section that fetches reviews from the Judge.me REST API and renders them in a luxury editorial Dossier-style UI. Use the Judge.me public API token "lE-kQ1qbvvxbIKiDqkDA30TGpPw" and shop domain "yj2f0t-t1.myshopify.com". The block should: fetch reviews via JavaScript using the Judge.me API endpoint (https://judge.me/api/v1/reviews?api_token=lE-kQ1qbvvxbIKiDqkDA30TGpPw&shop_domain=yj2f0t-t1.myshopify.com&product_id=PRODUCT_ID), render review cards with star rating (SVG stars), reviewer name, review date, review title, review body, and verified badge if applicable. Include client-side sorting (most recent, highest rated, lowest rated). For the "Write a Review" button, open Judge.me's hosted review form in a new tab using the URL format: https://judge.me/reviews/new?shop_domain=yj2f0t-t1.myshopify.com&platform=shopify&product_id={{ product.id }}&product_handle={{ product.handle }} — do NOT attempt a direct POST API call for review submission as it will fail due to CORS. Show aggregate rating summary at the top (average stars, total count, rating breakdown bars) calculated from the fetched reviews array. Style everything in a minimal luxury editorial aesthetic — clean sans-serif typography, generous whitespace, thin borders, muted tones, no heavy shadows. Make it fully responsive and mobile-friendly. The product_id should be dynamically pulled from Liquid using {{ product.id }}.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-reviews-dossier-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    color: {{ block.settings.text_color }};
    background-color: {{ block.settings.background_color }};
  }

  .ai-reviews-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 {{ block.settings.horizontal_padding }}px;
  }

  .ai-reviews-header-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-reviews-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    font-weight: 400;
    letter-spacing: -0.02em;
    margin: 0 0 {{ block.settings.title_spacing }}px;
    text-transform: {{ block.settings.title_transform }};
  }

  .ai-reviews-summary-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: {{ block.settings.summary_padding }}px 0;
    border-top: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    border-bottom: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    margin-bottom: {{ block.settings.summary_spacing }}px;
  }

  .ai-reviews-summary-top-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .ai-reviews-average-{{ ai_gen_id }} {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .ai-reviews-average-score-{{ ai_gen_id }} {
    font-size: 48px;
    font-weight: 300;
    line-height: 1;
  }

  .ai-reviews-average-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
  }

  .ai-reviews-average-count-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.muted_text_color }};
    margin-top: 8px;
  }

  .ai-reviews-write-btn-{{ ai_gen_id }} {
    padding: 12px 32px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_thickness }}px solid {{ block.settings.button_border_color }};
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .ai-reviews-write-btn-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
  }

  .ai-reviews-breakdown-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .ai-reviews-breakdown-row-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13px;
  }

  .ai-reviews-breakdown-label-{{ ai_gen_id }} {
    min-width: 60px;
    color: {{ block.settings.muted_text_color }};
  }

  .ai-reviews-breakdown-bar-{{ ai_gen_id }} {
    flex: 1;
    height: 6px;
    background-color: {{ block.settings.bar_bg_color }};
    border-radius: 3px;
    overflow: hidden;
  }

  .ai-reviews-breakdown-fill-{{ ai_gen_id }} {
    height: 100%;
    background-color: {{ block.settings.bar_fill_color }};
    transition: width 0.3s ease;
  }

  .ai-reviews-breakdown-count-{{ ai_gen_id }} {
    min-width: 40px;
    text-align: right;
    color: {{ block.settings.muted_text_color }};
  }

  .ai-reviews-controls-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: {{ block.settings.controls_spacing }}px;
    gap: 16px;
    flex-wrap: wrap;
  }

  .ai-reviews-sort-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .ai-reviews-sort-label-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.muted_text_color }};
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ai-reviews-sort-select-{{ ai_gen_id }} {
    padding: 8px 12px;
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    background-color: transparent;
    color: {{ block.settings.text_color }};
    font-size: 14px;
    cursor: pointer;
  }

  .ai-reviews-list-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.card_spacing }}px;
  }

  .ai-reviews-card-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    border: {{ block.settings.border_thickness }}px solid {{ block.settings.border_color }};
    background-color: {{ block.settings.card_bg_color }};
  }

  .ai-reviews-card-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 16px;
    gap: 16px;
  }

  .ai-reviews-card-meta-{{ ai_gen_id }} {
    flex: 1;
  }

  .ai-reviews-card-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    margin-bottom: 8px;
  }

  .ai-reviews-star-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
  }

  .ai-reviews-card-author-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 500;
    margin-bottom: 4px;
  }

  .ai-reviews-card-date-{{ ai_gen_id }} {
    font-size: 13px;
    color: {{ block.settings.muted_text_color }};
  }

  .ai-reviews-verified-badge-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background-color: {{ block.settings.verified_bg_color }};
    color: {{ block.settings.verified_text_color }};
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 2px;
  }

  .ai-reviews-verified-icon-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
  }

  .ai-reviews-card-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 500;
    margin: 0 0 12px;
  }

  .ai-reviews-card-body-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.6;
    color: {{ block.settings.body_text_color }};
  }

  .ai-reviews-loading-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    font-size: 14px;
    color: {{ block.settings.muted_text_color }};
  }

  .ai-reviews-empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
  }

  .ai-reviews-empty-title-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 400;
    margin: 0 0 12px;
  }

  .ai-reviews-empty-text-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.muted_text_color }};
    margin-bottom: 24px;
  }

  .ai-reviews-error-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.error_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-reviews-dossier-{{ ai_gen_id }} {
      width: 100%;
    }

