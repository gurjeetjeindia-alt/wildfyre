{% endstyle %}

<ai-reviews-dossier-{{ ai_gen_id }}
  class="ai-reviews-dossier-{{ ai_gen_id }}"
  data-product-id="{{ product.id }}"
  data-api-token="lE-kQ1qbvvxbIKiDqkDA30TGpPw"
  data-shop-domain="yj2f0t-t1.myshopify.com"
  {{ block.shopify_attributes }}
>
  <div class="ai-reviews-container-{{ ai_gen_id }}">
    <div class="ai-reviews-header-{{ ai_gen_id }}">
      <h2 class="ai-reviews-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
    </div>

    <div class="ai-reviews-summary-{{ ai_gen_id }}" style="display: none;">
      <div class="ai-reviews-summary-top-{{ ai_gen_id }}">
        <div>
          <div class="ai-reviews-average-{{ ai_gen_id }}">
            <span class="ai-reviews-average-score-{{ ai_gen_id }}" data-average-score>0.0</span>
            <div class="ai-reviews-average-stars-{{ ai_gen_id }}" data-average-stars></div>
          </div>
          <div class="ai-reviews-average-count-{{ ai_gen_id }}" data-review-count>0 reviews</div>
        </div>
        <a
          href="https://judge.me/reviews/new?shop_domain=yj2f0t-t1.myshopify.com&platform=shopify&product_id={{ product.id }}&product_handle={{ product.handle }}"
          target="_blank"
          rel="noopener noreferrer"
          class="ai-reviews-write-btn-{{ ai_gen_id }}"
        >
          {{ block.settings.write_review_text }}
        </a>
      </div>
      <div class="ai-reviews-breakdown-{{ ai_gen_id }}" data-breakdown></div>
    </div>

    <div class="ai-reviews-controls-{{ ai_gen_id }}" style="display: none;">
      <div class="ai-reviews-sort-{{ ai_gen_id }}">
        <label class="ai-reviews-sort-label-{{ ai_gen_id }}" for="sort-{{ ai_gen_id }}">Sort by</label>
        <select class="ai-reviews-sort-select-{{ ai_gen_id }}" id="sort-{{ ai_gen_id }}" data-sort-select>
          <option value="recent">Most recent</option>
          <option value="highest">Highest rated</option>
          <option value="lowest">Lowest rated</option>
        </select>
      </div>
    </div>

    <div class="ai-reviews-loading-{{ ai_gen_id }}" data-loading>Loading reviews...</div>
    <div class="ai-reviews-error-{{ ai_gen_id }}" data-error style="display: none;"></div>
    <div class="ai-reviews-empty-{{ ai_gen_id }}" data-empty style="display: none;">
      <h3 class="ai-reviews-empty-title-{{ ai_gen_id }}">No reviews yet</h3>
      <p class="ai-reviews-empty-text-{{ ai_gen_id }}">Be the first to share your experience</p>
      <a
        href="https://judge.me/reviews/new?shop_domain=yj2f0t-t1.myshopify.com&platform=shopify&product_id={{ product.id }}&product_handle={{ product.handle }}"
