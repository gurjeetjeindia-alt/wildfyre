{% doc %}
  @prompt
    A magazine-style editorial layout
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-editorial-layout-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-editorial-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    width: 100%;
  }

  .ai-editorial-item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-editorial-item-{{ ai_gen_id }}--large {
    grid-column: span 8;
    grid-row: span 2;
  }

  .ai-editorial-item-{{ ai_gen_id }}--medium {
    grid-column: span 4;
    grid-row: span 2;
  }

  .ai-editorial-item-{{ ai_gen_id }}--small {
    grid-column: span 4;
    grid-row: span 1;
  }

  .ai-editorial-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 400px;
    overflow: hidden;
  }

  .ai-editorial-item-{{ ai_gen_id }}--large .ai-editorial-image-wrapper-{{ ai_gen_id }} {
    min-height: 600px;
  }

  .ai-editorial-item-{{ ai_gen_id }}--small .ai-editorial-image-wrapper-{{ ai_gen_id }} {
    min-height: 280px;
  }

  .ai-editorial-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-editorial-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.placeholder_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-editorial-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
    opacity: 0.3;
  }

  .ai-editorial-content-{{ ai_gen_id }} {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: {{ block.settings.content_padding }}px;
    background: linear-gradient(
      to top,
      {{ block.settings.overlay_color }} 0%,
      transparent 100%
    );
    color: {{ block.settings.text_color }};
    z-index: 2;
  }

  .ai-editorial-category-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_font_size }}px;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 8px;
    font-weight: 400;
    opacity: 0.9;
  }

  .ai-editorial-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    line-height: 1.2;
    margin: 0 0 12px;
    font-weight: 700;
  }

  .ai-editorial-item-{{ ai_gen_id }}--small .ai-editorial-title-{{ ai_gen_id }} {
    font-size: calc({{ block.settings.title_font_size }}px * 0.7);
  }

  .ai-editorial-excerpt-{{ ai_gen_id }} {
    font-size: {{ block.settings.excerpt_font_size }}px;
    line-height: 1.6;
    margin: 0 0 16px;
    opacity: 0.95;
  }

  .ai-editorial-item-{{ ai_gen_id }}--small .ai-editorial-excerpt-{{ ai_gen_id }} {
    display: none;
  }

  .ai-editorial-link-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: {{ block.settings.text_color }};
    text-decoration: none;
    font-size: {{ block.settings.link_font_size }}px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 500;
    border-bottom: 1px solid {{ block.settings.text_color }};
    padding-bottom: 2px;
    transition: opacity 0.3s ease;
  }

  .ai-editorial-link-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-editorial-link-arrow-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    transition: transform 0.3s ease;
  }

  .ai-editorial-link-{{ ai_gen_id }}:hover .ai-editorial-link-arrow-{{ ai_gen_id }} {
    transform: translateX(4px);
  }

  @media screen and (max-width: 989px) {
    .ai-editorial-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(6, 1fr);
      gap: {{ block.settings.mobile_grid_gap }}px;
    }

    .ai-editorial-item-{{ ai_gen_id }}--large {
      grid-column: span 6;
      grid-row: span 1;
    }

    .ai-editorial-item-{{ ai_gen_id }}--medium {
      grid-column: span 6;
      grid-row: span 1;
    }

    .ai-editorial-item-{{ ai_gen_id }}--small {
      grid-column: span 3;
      grid-row: span 1;
    }

    .ai-editorial-image-wrapper-{{ ai_gen_id }} {
      min-height: 300px;
    }

    .ai-editorial-item-{{ ai_gen_id }}--large .ai-editorial-image-wrapper-{{ ai_gen_id }} {
      min-height: 400px;
    }

    .ai-editorial-item-{{ ai_gen_id }}--small .ai-editorial-image-wrapper-{{ ai_gen_id }} {
      min-height: 200px;
    }

    .ai-editorial-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_font_size }}px * 0.8);
    }

    .ai-editorial-excerpt-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.excerpt_font_size }}px * 0.9);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-editorial-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-editorial-item-{{ ai_gen_id }}--large,
    .ai-editorial-item-{{ ai_gen_id }}--medium,
    .ai-editorial-item-{{ ai_gen_id }}--small {
      grid-column: span 1;
      grid-row: span 1;
    }

    .ai-editorial-image-wrapper-{{ ai_gen_id }},
    .ai-editorial-item-{{ ai_gen_id }}--large .ai-editorial-image-wrapper-{{ ai_gen_id }},
    .ai-editorial-item-{{ ai_gen_id }}--small .ai-editorial-image-wrapper-{{ ai_gen_id }} {
      min-height: 350px;
    }

    .ai-editorial-item-{{ ai_gen_id }}--small .ai-editorial-excerpt-{{ ai_gen_id }} {
      display: block;
    }

    .ai-editorial-item-{{ ai_gen_id }}--small .ai-editorial-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_font_size }}px * 0.8);
    }
  }
{% endstyle %}

<editorial-layout-{{ ai_gen_id }}
  class="ai-editorial-layout-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-editorial-grid-{{ ai_gen_id }}">
    {% for i in (1..6) %}
      {% liquid
        assign item_enabled_key = 'item_' | append: i | append: '_enabled'
        assign item_size_key = 'item_' | append: i | append: '_size'
        assign item_image_key = 'item_' | append: i | append: '_image'
        assign item_category_key = 'item_' | append: i | append: '_category'
        assign item_title_key = 'item_' | append: i | append: '_title'
        assign item_excerpt_key = 'item_' | append: i | append: '_excerpt'
        assign item_link_text_key = 'item_' | append: i | append: '_link_text'
        assign item_link_url_key = 'item_' | append: i | append: '_link_url'

        assign item_enabled = block.settings[item_enabled_key]
        assign item_size = block.settings[item_size_key]
        assign item_image = block.settings[item_image_key]
        assign item_category = block.settings[item_category_key]
        assign item_title = block.settings[item_title_key]
        assign item_excerpt = block.settings[item_excerpt_key]
        assign item_link_text = block.settings[item_link_text_key]
        assign item_link_url = block.settings[item_link_url_key]
      %}

      {% if item_enabled %}
        <div class="ai-editorial-item-{{ ai_gen_id }} ai-editorial-item-{{ ai_gen_id }}--{{ item_size }}">
          <div class="ai-editorial-image-wrapper-{{ ai_gen_id }}">
            {% if item_image %}
              <img
                src="{{ item_image | image_url: width: 1200 }}"
                alt="{{ item_image.alt | escape }}"
                loading="lazy"
                width="{{ item_image.width }}"
                height="{{ item_image.height }}"
                class="ai-editorial-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-editorial-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          <div class="ai-editorial-content-{{ ai_gen_id }}">
            {% if item_category != blank %}
              <div class="ai-editorial-category-{{ ai_gen_id }}">{{ item_category }}</div>
            {% endif %}

            {% if item_title != blank %}
              <h3 class="ai-editorial-title-{{ ai_gen_id }}">{{ item_title }}</h3>
            {% endif %}

            {% if item_excerpt != blank %}
              <div class="ai-editorial-excerpt-{{ ai_gen_id }}">{{ item_excerpt }}</div>
            {% endif %}

            {% if item_link_text != blank and item_link_url != blank %}
              <a href="{{ item_link_url }}" class="ai-editorial-link-{{ ai_gen_id }}">
                {{ item_link_text }}
                <svg
                  class="ai-editorial-link-arrow-{{ ai_gen_id }}"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</editorial-layout-{{ ai_gen_id }}>

<script>
  (function() {
    class EditorialLayout{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.adjustOverlayHeights();
        window.addEventListener('resize', () => this.adjustOverlayHeights());
      }

      adjustOverlayHeights() {
        const items = this.querySelectorAll('.ai-editorial-item-{{ ai_gen_id }}');
        items.forEach((item) => {
          const content = item.querySelector('.ai-editorial-content-{{ ai_gen_id }}');
          if (content) {
            const contentHeight = content.offsetHeight;
            content.style.background = `linear-gradient(to top, {{ block.settings.overlay_color }} 0%, rgba(0,0,0,0) ${contentHeight}px)`;
          }
        });
      }
    }

    customElements.define('editorial-layout-{{ ai_gen_id }}', EditorialLayout{{ ai_gen_id }});
  })();
</script>

