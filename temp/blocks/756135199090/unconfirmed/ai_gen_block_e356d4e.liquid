{% doc %}
  @prompt
    Create a new custom footer section for a premium fragrance brand called WILDFYRE. The footer should include:
    
    1. A top navigation links area with columns for: Shop, About, Support, Account, and Social links — but the specific links/items in each column should be fully customizable via theme settings (editable link lists or text fields for each column heading and its links).
    2. A bottom bar that always shows the brand name "WILDFYRE" as a heading/logo text.
    3. A "Join the World" email subscribe section with a newsletter signup input and submit button.
    
    The footer should match a luxury, editorial aesthetic with muted tones, refined typography, and clean layout. All link columns and their items should be fully editable in the theme editor. This is a brand new footer section separate from any existing footer.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-wildfyre-footer-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-wildfyre-footer__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-wildfyre-footer__top-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: {{ block.settings.column_gap }}px;
    padding-bottom: {{ block.settings.section_spacing }}px;
    border-bottom: {{ block.settings.divider_thickness }}px solid {{ block.settings.divider_color }};
  }

  .ai-wildfyre-footer__column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.link_spacing }}px;
  }

  .ai-wildfyre-footer__column-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.column_title_size }}px;
    font-weight: {{ block.settings.column_title_weight }};
    letter-spacing: {{ block.settings.column_title_spacing }}px;
    text-transform: {{ block.settings.column_title_transform }};
    margin: 0 0 {{ block.settings.title_margin_bottom }}px;
    color: {{ block.settings.column_title_color }};
  }

  .ai-wildfyre-footer__link-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-size: {{ block.settings.link_size }}px;
    transition: color 0.3s ease, opacity 0.3s ease;
    display: inline-block;
  }

  .ai-wildfyre-footer__link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
    opacity: {{ block.settings.link_hover_opacity | divided_by: 100.0 }};
  }

  .ai-wildfyre-footer__newsletter-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.newsletter_gap }}px;
  }

  .ai-wildfyre-footer__newsletter-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.newsletter_title_size }}px;
    font-weight: {{ block.settings.newsletter_title_weight }};
    letter-spacing: {{ block.settings.newsletter_title_spacing }}px;
    margin: 0;
    color: {{ block.settings.newsletter_title_color }};
  }

  .ai-wildfyre-footer__newsletter-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.newsletter_text_size }}px;
    line-height: 1.5;
    margin: 0;
    opacity: 0.8;
  }

  .ai-wildfyre-footer__newsletter-form-wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .ai-wildfyre-footer__newsletter-input-{{ ai_gen_id }} {
    flex: 1;
    min-width: 200px;
    padding: {{ block.settings.input_padding }}px;
    border: {{ block.settings.input_border_thickness }}px solid {{ block.settings.input_border_color }};
    background-color: {{ block.settings.input_background }};
    color: {{ block.settings.input_text_color }};
    font-size: {{ block.settings.input_font_size }}px;
    border-radius: {{ block.settings.input_border_radius }}px;
  }

  .ai-wildfyre-footer__newsletter-input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.input_placeholder_color }};
    opacity: 0.6;
  }

  .ai-wildfyre-footer__newsletter-input-{{ ai_gen_id }}:focus {
    outline: none;
    border-color: {{ block.settings.input_focus_border_color }};
  }

  .ai-wildfyre-footer__newsletter-button-{{ ai_gen_id }} {
    padding: {{ block.settings.button_padding }}px {{ block.settings.button_padding | times: 1.5 }}px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_thickness }}px solid {{ block.settings.button_border_color }};
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
    text-transform: {{ block.settings.button_text_transform }};
    cursor: pointer;
    transition: all 0.3s ease;
    border-radius: {{ block.settings.button_border_radius }}px;
  }

  .ai-wildfyre-footer__newsletter-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-wildfyre-footer__newsletter-message-{{ ai_gen_id }} {
    font-size: 14px;
    margin-top: 8px;
  }

  .ai-wildfyre-footer__newsletter-success-{{ ai_gen_id }} {
    color: {{ block.settings.success_color }};
  }

  .ai-wildfyre-footer__newsletter-error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
  }

  .ai-wildfyre-footer__social-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.link_spacing }}px;
  }

  .ai-wildfyre-footer__social-icons-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.social_icon_gap }}px;
    flex-wrap: wrap;
  }

  .ai-wildfyre-footer__social-link-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.social_icon_size }}px;
    height: {{ block.settings.social_icon_size }}px;
    color: {{ block.settings.social_icon_color }};
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .ai-wildfyre-footer__social-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.social_icon_hover_color }};
    transform: translateY(-2px);
  }

  .ai-wildfyre-footer__social-link-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-wildfyre-footer__bottom-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: {{ block.settings.section_spacing }}px;
    gap: 20px;
    flex-wrap: wrap;
  }

  .ai-wildfyre-footer__brand-{{ ai_gen_id }} {
    font-size: {{ block.settings.brand_size }}px;
    font-weight: {{ block.settings.brand_weight }};
    letter-spacing: {{ block.settings.brand_spacing }}px;
    text-transform: {{ block.settings.brand_transform }};
    margin: 0;
    color: {{ block.settings.brand_color }};
  }

  .ai-wildfyre-footer__copyright-{{ ai_gen_id }} {
    font-size: {{ block.settings.copyright_size }}px;
    opacity: 0.7;
    margin: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-wildfyre-footer__top-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_column_gap }}px;
    }

    .ai-wildfyre-footer__bottom-{{ ai_gen_id }} {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }

    .ai-wildfyre-footer__newsletter-form-wrapper-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-wildfyre-footer__newsletter-input-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<wildfyre-footer-{{ ai_gen_id }} class="ai-wildfyre-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-wildfyre-footer__container-{{ ai_gen_id }}">
    <div class="ai-wildfyre-footer__top-{{ ai_gen_id }}">
      {% if block.settings.show_shop_column %}
        <div class="ai-wildfyre-footer__column-{{ ai_gen_id }}">
          {% if block.settings.shop_column_title != blank %}
            <h3 class="ai-wildfyre-footer__column-title-{{ ai_gen_id }}">{{ block.settings.shop_column_title }}</h3>
          {% endif %}
          {% if block.settings.shop_menu != blank %}
            {% for link in block.settings.shop_menu.links %}
              <a href="{{ link.url }}" class="ai-wildfyre-footer__link-{{ ai_gen_id }}">{{ link.title }}</a>
            {% endfor %}
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.show_about_column %}
        <div class="ai-wildfyre-footer__column-{{ ai_gen_id }}">
          {% if block.settings.about_column_title != blank %}
            <h3 class="ai-wildfyre-footer__column-title-{{ ai_gen_id }}">{{ block.settings.about_column_title }}</h3>
          {% endif %}
          {% if block.settings.about_menu != blank %}
            {% for link in block.settings.about_menu.links %}
              <a href="{{ link.url }}" class="ai-wildfyre-footer__link-{{ ai_gen_id }}">{{ link.title }}</a>
            {% endfor %}
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.show_support_column %}
        <div class="ai-wildfyre-footer__column-{{ ai_gen_id }}">
          {% if block.settings.support_column_title != blank %}
            <h3 class="ai-wildfyre-footer__column-title-{{ ai_gen_id }}">{{ block.settings.support_column_title }}</h3>
          {% endif %}
          {% if block.settings.support_menu != blank %}
            {% for link in block.settings.support_menu.links %}
              <a href="{{ link.url }}" class="ai-wildfyre-footer__link-{{ ai_gen_id }}">{{ link.title }}</a>
            {% endfor %}
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.show_account_column %}
        <div class="ai-wildfyre-footer__column-{{ ai_gen_id }}">
          {% if block.settings.account_column_title != blank %}
            <h3 class="ai-wildfyre-footer__column-title-{{ ai_gen_id }}">{{ block.settings.account_column_title }}</h3>
          {% endif %}
          {% if block.settings.account_menu != blank %}
            {% for link in block.settings.account_menu.links %}
              <a href="{{ link.url }}" class="ai-wildfyre-footer__link-{{ ai_gen_id }}">{{ link.title }}</a>
            {% endfor %}
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.show_social_column %}
        <div class="ai-wildfyre-footer__column-{{ ai_gen_id }} ai-wildfyre-footer__social-{{ ai_gen_id }}">
          {% if block.settings.social_column_title != blank %}
            <h3 class="ai-wildfyre-footer__column-title-{{ ai_gen_id }}">{{ block.settings.social_column_title }}</h3>
          {% endif %}
          <div class="ai-wildfyre-footer__social-icons-{{ ai_gen_id }}">
            {% if block.settings.social_instagram != blank %}
              <a href="{{ block.settings.social_instagram }}" class="ai-wildfyre-footer__social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="Instagram">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </a>
            {% endif %}
            {% if block.settings.social_facebook != blank %}
              <a href="{{ block.settings.social_facebook }}" class="ai-wildfyre-footer__social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="Facebook">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                </svg>
              </a>
            {% endif %}
            {% if block.settings.social_twitter != blank %}
              <a href="{{ block.settings.social_twitter }}" class="ai-wildfyre-footer__social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="Twitter">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path>
                </svg>
              </a>
            {% endif %}
            {% if block.settings.social_youtube != blank %}
              <a href="{{ block.settings.social_youtube }}" class="ai-wildfyre-footer__social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="YouTube">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path>
                  <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
                </svg>
              </a>
            {% endif %}
            {% if block.settings.social_tiktok != blank %}
              <a href="{{ block.settings.social_tiktok }}" class="ai-wildfyre-footer__social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="TikTok">
                <svg viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5 20.1a6.34 6.34 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.52v-3.4a4.85 4.85 0 0 1-1-.1z"/>
                </svg>
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}

      {% if block.settings.show_newsletter %}
        <div class="ai-wildfyre-footer__column-{{ ai_gen_id }} ai-wildfyre-footer__newsletter-{{ ai_gen_id }}">
          {% if block.settings.newsletter_title != blank %}
            <h3 class="ai-wildfyre-footer__newsletter-title-{{ ai_gen_id }}">{{ block.settings.newsletter_title }}</h3>
          {% endif %}
          {% if block.settings.newsletter_text != blank %}
            <p class="ai-wildfyre-footer__newsletter-text-{{ ai_gen_id }}">{{ block.settings.newsletter_text }}</p>
          {% endif %}
          {% form 'customer' %}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="ai-wildfyre-footer__newsletter-form-wrapper-{{ ai_gen_id }}">
              <input
                type="email"
                name="contact[email]"
                class="ai-wildfyre-footer__newsletter-input-{{ ai_gen_id }}"
                placeholder="{{ block.settings.newsletter_placeholder }}"
                aria-label="Email address"
                required
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="newsletter-error-{{ ai_gen_id }}"
                {% endif %}
                {% if form.posted_successfully? %}
                  aria-describedby="newsletter-success-{{ ai_gen_id }}"
                {% endif %}
              >
              <button type="submit" class="ai-wildfyre-footer__newsletter-button-{{ ai_gen_id }}">
                {{ block.settings.newsletter_button_text }}
              </button>
            </div>
            {% if form.errors %}
              <div id="newsletter-error-{{ ai_gen_id }}" class="ai-wildfyre-footer__newsletter-message-{{ ai_gen_id }} ai-wildfyre-footer__newsletter-error-{{ ai_gen_id }}">
                {{ form.errors.messages.email }}
              </div>
            {% endif %}
            {% if form.posted_successfully? %}
              <div id="newsletter-success-{{ ai_gen_id }}" class="ai-wildfyre-footer__newsletter-message-{{ ai_gen_id }} ai-wildfyre-footer__newsletter-success-{{ ai_gen_id }}">
                {{ block.settings.newsletter_success_message }}
              </div>
            {% endif %}
          {% endform %}
        </div>
      {% endif %}
    </div>

    <div class="ai-wildfyre-footer__bottom-{{ ai_gen_id }}">
      <h2 class="ai-wildfyre-footer__brand-{{ ai_gen_id }}">{{ block.settings.brand_name }}</h2>
      {% if block.settings.show_copyright %}
        <p class="ai-wildfyre-footer__copyright-{{ ai_gen_id }}">
          {{ block.settings.copyright_text | replace: '[year]', 'now' | date: '%Y' }}
        </p>
      {% endif %}
    </div>
  </div>
</wildfyre-footer-{{ ai_gen_id }}>

<script>
  (function() {
    class WildfyreFooter{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.init();
      }

      init() {
        const forms = this.querySelectorAll('form');
        forms.forEach(function(form) {
          form.addEventListener('submit', function(event) {
            const emailInput = form.querySelector('input[type="email"]');
            if (emailInput && !emailInput.value.trim()) {
              event.preventDefault();
            }
          });
        });
      }
    }

    customElements.define('wildfyre-footer-{{ ai_gen_id }}', WildfyreFooter{{ ai_gen_id }});
  })();
</script>

