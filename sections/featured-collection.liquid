{%- style -%}

  /* =========================================================
     WILDFYRE — FEATURED COLLECTION
     Editorial / premium fragrance product grid
     ========================================================= */

  .section-{{ section.id }}-padding {
    padding-top: 0 !important;
    padding-bottom: 0 !important;
    margin: 0 !important;
  }

  /* ---------------------------------------------------------
     FULL-WIDTH SECTION
     --------------------------------------------------------- */

  .collection.section-{{ section.id }}-padding {
    width: 100vw !important;
    max-width: 100vw !important;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw !important;
    margin-right: -50vw !important;
    overflow: hidden;
  }

  .collection.section-{{ section.id }}-padding .slider-mobile-gutter,
  .collection.section-{{ section.id }}-padding .page-width,
  .collection.section-{{ section.id }}-padding .page-width-desktop,
  .collection.section-{{ section.id }}-padding .slider-component-full-width,
  .collection.section-{{ section.id }}-padding .slider-component-desktop {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* ---------------------------------------------------------
     SECTION HEADING
     --------------------------------------------------------- */

  .collection.section-{{ section.id }}-padding
    .collection__title.title-wrapper {
    width: 100% !important;
    padding: 2rem 2rem 1.75rem !important;
    margin: 0 !important;
  }

  .collection__title .title {
    font-family:
      "Iowan Old Style",
      "Palatino Linotype",
      "Book Antiqua",
      Palatino,
      Georgia,
      serif !important;

    font-size: clamp(2rem, 3.2vw, 3.15rem) !important;
    font-weight: 400 !important;
    letter-spacing: -0.015em !important;
    line-height: 1.05 !important;

    color: #111 !important;

    margin: 0 !important;
  }

  .collection__description {
    max-width: 600px;
    margin-top: 0.65rem !important;

    font-size: 0.85rem;
    line-height: 1.5;
    letter-spacing: 0.02em;

    color: #777;
  }

  .collection.section-{{ section.id }}-padding
    .collection__title.title-wrapper
    .collection__description {
    margin-top: 0.65rem !important;
    padding: 0 !important;
  }

  /* ---------------------------------------------------------
     PRODUCT GRID
     --------------------------------------------------------- */

  .collection.section-{{ section.id }}-padding
    .grid.product-grid {
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;

    column-gap: 0 !important;
    row-gap: 0 !important;
  }

  .collection.section-{{ section.id }}-padding
    .grid__item {
    margin: 0 !important;
    padding: 0 !important;

    min-width: 0;
  }

  @media screen and (min-width: 990px) {
    .collection.section-{{ section.id }}-padding
      .grid__item {
      width: 25% !important;
      max-width: 25% !important;
    }
  }

  /* ---------------------------------------------------------
     PRODUCT CARD
     --------------------------------------------------------- */

  .collection.section-{{ section.id }}-padding
    .card-wrapper,
  .collection.section-{{ section.id }}-padding
    .card {
    margin: 0 !important;
    padding: 0 !important;

    border-radius: 0 !important;
  }

  .collection .card {
    border: 0 !important;
    background: transparent !important;
  }

  /* Remove theme hover movement */
  .collection .card-wrapper:hover {
    transform: none !important;
  }

  .collection .card-wrapper:hover .card--card::before,
  .collection .card-wrapper:hover
    .card--standard
    .card__media::after {
    opacity: inherit !important;
    background-image: inherit !important;
  }

  .collection .card-wrapper:hover .card--card,
  .collection .card-wrapper:hover
    .card--standard
    .card__inner {
    box-shadow: none !important;
  }

  /* ---------------------------------------------------------
     PRODUCT IMAGE
     --------------------------------------------------------- */

  .collection.section-{{ section.id }}-padding
    .card__inner,
  .collection.section-{{ section.id }}-padding
    .card--card,
  .collection.section-{{ section.id }}-padding
    .card--standard
    .card__inner,
  .collection.section-{{ section.id }}-padding
    .card__media,
  .collection.section-{{ section.id }}-padding
    .card__media
    .media {
    background: transparent !important;

    border: 0 !important;
    border-radius: 0 !important;

    box-shadow: none !important;
  }

  .collection.section-{{ section.id }}-padding
    .card__inner.ratio::before {
    padding-bottom: calc(var(--ratio-percent) + 12%) !important;
  }

  .collection.section-{{ section.id }}-padding
    .card__media,
  .collection.section-{{ section.id }}-padding
    .card__media
    .media,
  .collection.section-{{ section.id }}-padding
    .card__media
    .media
    img {
    display: block !important;

    width: 100% !important;

    border: 0 !important;
    border-radius: 0 !important;

    box-shadow: none !important;

    margin: 0 !important;
  }

  /* ---------------------------------------------------------
     SUBTLE IMAGE HOVER
     --------------------------------------------------------- */

  .collection.section-{{ section.id }}-padding
    .card__media
    img {
    transition:
      transform 0.7s cubic-bezier(0.2, 0.65, 0.25, 1),
      opacity 0.45s ease !important;
  }

  .collection.section-{{ section.id }}-padding
    .card-wrapper:hover
    .card__media
    img:first-child {
    transform: scale(1.025) !important;
  }

  /* Keep secondary image hidden unless enabled
     through the Shopify section setting */
  .collection
    .card-wrapper:hover
    .media.media--hover-effect
    > img
    + img {
    opacity: 0 !important;
  }

  /* ---------------------------------------------------------
     PRODUCT INFORMATION
     --------------------------------------------------------- */

  .collection.section-{{ section.id }}-padding
    .card__content {
    border: 0 !important;

    border-top: 1px solid #e4e4e4 !important;

    border-right: 1px solid #e4e4e4 !important;

    border-radius: 0 !important;

    background: #fff !important;

    padding: 1.15rem 1rem 1.35rem !important;

    margin: 0 !important;
  }

  .collection.section-{{ section.id }}-padding
    .card__information {
    padding: 0 !important;
    margin: 0 !important;
  }

  /* ---------------------------------------------------------
     PRODUCT NAME
     --------------------------------------------------------- */

  .collection.section-{{ section.id }}-padding
    .card__information
    .card__heading {
    font-family:
      "Iowan Old Style",
      "Palatino Linotype",
      "Book Antiqua",
      Palatino,
      Georgia,
      serif !important;

    font-size: clamp(1.25rem, 1.55vw, 1.55rem) !important;

    font-weight: 400 !important;

    letter-spacing: 0.005em !important;

    line-height: 1.15 !important;

    margin: 0 0 0.65rem !important;
  }

  .collection.section-{{ section.id }}-padding
    .card__information
    .card__heading
    a {
    color: #111 !important;
    text-decoration: none !important;
  }

  .collection.section-{{ section.id }}-padding
    .card__information
    .card__heading
    a:hover {
    text-decoration: underline !important;
    text-underline-offset: 0.2em;
  }

  /* ---------------------------------------------------------
     PRICE
     --------------------------------------------------------- */

  .collection.section-{{ section.id }}-padding
    .price {
    margin: 0 !important;

    font-family:
      -apple-system,
      BlinkMacSystemFont,
      "Helvetica Neue",
      Arial,
      sans-serif !important;

    font-size: 0.82rem !important;

    line-height: 1.4 !important;

    letter-spacing: 0.01em !important;
  }

  .collection.section-{{ section.id }}-padding
    .price
    .price-item {
    margin: 0 !important;
  }

  .collection.section-{{ section.id }}-padding
    .price
    .price-item--regular {
    color: #8a8a8a !important;

    text-decoration: line-through;

    margin-right: 0.35rem !important;
  }

  .collection.section-{{ section.id }}-padding
    .price
    .price-item--sale {
    color: #111 !important;

    font-weight: 600 !important;
  }

  /* ---------------------------------------------------------
     SALE BADGE
     --------------------------------------------------------- */

  .collection.section-{{ section.id }}-padding
    .card__badge {
    margin: 0 !important;

    position: absolute;

    left: 0.75rem;
    bottom: 0.75rem;

    z-index: 3;
  }

  .collection.section-{{ section.id }}-padding
    .card__badge
    .badge {
    display: inline-flex !important;
    align-items: center;
    justify-content: center;

    min-height: 0 !important;

    padding: 0.38rem 0.65rem !important;

    border: 0 !important;
    border-radius: 999px !important;

    background: #111 !important;
    color: #fff !important;

    font-family:
      -apple-system,
      BlinkMacSystemFont,
      "Helvetica Neue",
      Arial,
      sans-serif !important;

    font-size: 0.63rem !important;

    font-weight: 600 !important;

    letter-spacing: 0.08em !important;

    line-height: 1 !important;
  }

  /* ---------------------------------------------------------
     SLIDER CONTROLS
     --------------------------------------------------------- */

  .collection.section-{{ section.id }}-padding
    .slider-buttons {
    display: flex !important;

    align-items: center;
    justify-content: center;

    gap: 1.25rem;

    margin: 0 !important;

    padding: 1.1rem 1rem 0.5rem !important;
  }

  .collection.section-{{ section.id }}-padding
    .slider-button {
    width: 2rem !important;
    height: 2rem !important;

    border: 0 !important;

    background: transparent !important;

    color: #111 !important;

    transition:
      opacity 0.25s ease,
      transform 0.25s ease !important;
  }

  .collection.section-{{ section.id }}-padding
    .slider-button:hover {
    opacity: 0.55 !important;
    transform: scale(1.08);
  }

  .collection.section-{{ section.id }}-padding
    .slider-button--prev
    .svg-wrapper {
    transform: rotate(90deg);
  }

  .collection.section-{{ section.id }}-padding
    .slider-button--next
    .svg-wrapper {
    transform: rotate(-90deg);
  }

  .collection.section-{{ section.id }}-padding
    .slider-counter {
    min-width: 3rem;

    font-size: 0.7rem !important;

    letter-spacing: 0.08em;

    color: #555 !important;
  }

  /* ---------------------------------------------------------
     VIEW ALL
     --------------------------------------------------------- */

  .collection.section-{{ section.id }}-padding
    .collection__view-all {
    margin: 0 !important;

    padding: 1.15rem 1rem 2rem !important;
  }

  .collection.section-{{ section.id }}-padding
    .collection__view-all
    .button {
    display: inline-flex !important;

    align-items: center;
    justify-content: center;

    min-width: 130px;

    min-height: 46px;

    padding: 0.8rem 1.5rem !important;

    border: 1px solid #111 !important;
    border-radius: 0 !important;

    background: #111 !important;
    color: #fff !important;

    font-family:
      -apple-system,
      BlinkMacSystemFont,
      "Helvetica Neue",
      Arial,
      sans-serif !important;

    font-size: 0.68rem !important;

    font-weight: 600 !important;

    letter-spacing: 0.12em !important;

    text-transform: uppercase;

    transition:
      background 0.25s ease,
      color 0.25s ease !important;
  }

  .collection.section-{{ section.id }}-padding
    .collection__view-all
    .button:hover {
    background: transparent !important;
    color: #111 !important;
  }

  /* ---------------------------------------------------------
     TABLET
     --------------------------------------------------------- */

  @media screen and (max-width: 989px) {

    .collection.section-{{ section.id }}-padding
      .collection__title.title-wrapper {
      padding: 1.6rem 1.25rem 1.35rem !important;
    }

    .collection__title .title {
      font-size: clamp(1.85rem, 5vw, 2.5rem) !important;
    }

    .collection.section-{{ section.id }}-padding
      .card__information
      .card__heading {
      font-size: 1.2rem !important;
    }

    .collection.section-{{ section.id }}-padding
      .card__content {
      padding: 1rem 0.8rem 1.1rem !important;
    }
  }

  /* ---------------------------------------------------------
     MOBILE
     --------------------------------------------------------- */

  @media screen and (max-width: 749px) {

    .collection.section-{{ section.id }}-padding
      .collection__title.title-wrapper {
      padding: 1.35rem 1rem 1.15rem !important;
    }

    .collection__title .title {
      font-size: clamp(1.75rem, 8vw, 2.25rem) !important;

      letter-spacing: -0.01em !important;
    }

    .collection__description {
      font-size: 0.78rem;
    }

    /* Two-column mobile layout */
    .collection.section-{{ section.id }}-padding
      .grid__item {
      width: 50% !important;
      max-width: 50% !important;
    }

    .collection.section-{{ section.id }}-padding
      .card__content {
      padding: 0.85rem 0.7rem 1rem !important;

      border-top: 1px solid #e4e4e4 !important;
    }

    .collection.section-{{ section.id }}-padding
      .card__information
      .card__heading {
      font-size: 1.05rem !important;

      line-height: 1.15 !important;

      margin-bottom: 0.45rem !important;
    }

    .collection.section-{{ section.id }}-padding
      .price {
      font-size: 0.72rem !important;
    }

    .collection.section-{{ section.id }}-padding
      .card__badge {
      left: 0.55rem;
      bottom: 0.55rem;
    }

    .collection.section-{{ section.id }}-padding
      .card__badge
      .badge {
      padding: 0.32rem 0.5rem !important;

      font-size: 0.55rem !important;
    }

    .collection.section-{{ section.id }}-padding
      .slider-buttons {
      padding-top: 0.85rem !important;
    }

    .collection.section-{{ section.id }}-padding
      .collection__view-all {
      padding: 0.9rem 1rem 1.5rem !important;
    }

    .collection.section-{{ section.id }}-padding
      .collection__view-all
      .button {
      min-width: 120px;
      min-height: 42px;

      font-size: 0.62rem !important;
    }
  }

  /* ---------------------------------------------------------
     ACCESSIBILITY / REDUCED MOTION
     --------------------------------------------------------- */

  @media (prefers-reduced-motion: reduce) {

    .collection.section-{{ section.id }}-padding
      .card__media
      img,
    .collection.section-{{ section.id }}-padding
      .slider-button,
    .collection.section-{{ section.id }}-padding
      .collection__view-all
      .button {
      transition: none !important;
    }

    .collection.section-{{ section.id }}-padding
      .card-wrapper:hover
      .card__media
      img:first-child {
      transform: none !important;
    }
  }

{%- endstyle -%}