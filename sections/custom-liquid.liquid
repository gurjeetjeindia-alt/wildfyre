<style>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Inter:wght@300;400;500&display=swap');

/* ================================
   WILDFYRE COLLECTION SELECTOR
================================ */

.wf-luxury {
  position: relative;
  width: 100%;
  height: 100vh;
  height: 100svh;
  overflow: hidden;
  background: #000;
}

/* ================================
   THREE PANEL GRID
================================ */

.wf-split {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  width: 100%;
  height: 100%;
}

.wf-panel {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  text-decoration: none;
  color: #fff;
  cursor: pointer;
}

/* IMAGE */

.wf-panel img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 1.5s ease;
}

.wf-panel:hover img {
  transform: scale(1.06);
}

/* DARK OVERLAY */

.wf-panel::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(
    to bottom,
    rgba(0,0,0,0.08),
    rgba(0,0,0,0.12),
    rgba(0,0,0,0.78)
  );
}

/* ================================
   COLLECTION TITLE
================================ */

.wf-title {
  position: absolute;
  top: 8%;
  left: 50%;
  transform: translateX(-50%);
  z-index: 3;

  width: 100%;

  font-family: "Cormorant Garamond", serif;
  font-size: clamp(60px, 7vw, 140px);
  font-weight: 600;
  letter-spacing: 0.08em;

  color: #fff;
  text-align: center;

  pointer-events: none;
}

/* ================================
   BOTTOM CONTENT
================================ */

.wf-content {
  position: absolute;
  left: 40px;
  right: 40px;
  bottom: 40px;

  z-index: 3;

  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.wf-label {
  margin-bottom: 10px;

  font-family: "Inter", sans-serif;
  font-size: 11px;
  font-weight: 400;
  letter-spacing: 0.25em;
  text-transform: uppercase;

  color: rgba(255,255,255,0.72);
}

.wf-link {
  font-family: "Inter", sans-serif;
  font-size: 13px;
  font-weight: 400;
  letter-spacing: 0.15em;
  text-transform: uppercase;

  color: #fff;
}

/* ================================
   ARROW
================================ */

.wf-arrow {
  width: 58px;
  height: 58px;

  flex-shrink: 0;

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;

  background: #fff;
  color: #000;

  font-size: 22px;

  transition: transform 0.3s ease;
}

.wf-panel:hover .wf-arrow {
  transform: scale(1.1);
}

/* ================================
   DESKTOP CURSOR
================================ */

#wf-dot {
  display: none;
}

#wf-circle {
  display: none;
}

@media (min-width: 769px) {

  #wf-dot {
    display: block;

    position: fixed;

    width: 10px;
    height: 10px;

    background: #fff;
    border-radius: 50%;

    pointer-events: none;

    z-index: 999999;

    transform: translate(-50%, -50%);
  }

  #wf-circle {
    display: block;

    position: fixed;

    width: 40px;
    height: 40px;

    border: 1px solid rgba(255,255,255,0.8);
    border-radius: 50%;

    pointer-events: none;

    z-index: 999998;

    transform: translate(-50%, -50%);

    transition:
      width 0.3s ease,
      height 0.3s ease;
  }

  .wf-hovering #wf-circle {
    width: 75px;
    height: 75px;
  }
}

/* ================================
   MOBILE
   THREE PANELS SIDE BY SIDE
================================ */

@media (max-width: 768px) {

  .wf-luxury {
    width: 100%;
    height: 100svh;
    min-height: 100svh;

    overflow: hidden;
  }

  .wf-split {
    display: grid;

    grid-template-columns:
      repeat(3, minmax(0, 1fr));

    grid-template-rows: 1fr;

    width: 100%;
    height: 100%;

    margin: 0;
    padding: 0;

    gap: 0;
  }

  .wf-panel {
    position: relative;

    width: 100%;
    height: 100%;

    min-width: 0;
    min-height: 0;

    overflow: hidden;
  }

  .wf-panel img {
    position: absolute;

    top: 0;
    left: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;
  }

  /* MOBILE TITLES */

  .wf-title {
    position: absolute;

    top: 38px;
    left: 50%;

    transform: translateX(-50%);

    width: 100%;

    font-size: 7vw;
    line-height: 1;

    letter-spacing: 0.02em;

    white-space: nowrap;

    text-align: center;
  }

  /* MOBILE BOTTOM CONTENT */

  .wf-content {
    position: absolute;

    left: 4px;
    right: 4px;
    bottom: 18px;

    display: flex;

    flex-direction: column;

    align-items: center;
    justify-content: flex-end;

    text-align: center;
  }

  .wf-label {
    margin-bottom: 6px;

    font-size: 6px;
    line-height: 1.2;

    letter-spacing: 0.10em;

    white-space: nowrap;
  }

  .wf-link {
    font-size: 7px;
    line-height: 1.2;

    letter-spacing: 0.06em;

    white-space: nowrap;
  }

  .wf-arrow {
    width: 30px;
    height: 30px;

    margin-top: 10px;

    font-size: 14px;
  }
}

/* ================================
   VERY SMALL PHONES
================================ */

@media (max-width: 380px) {

  .wf-title {
    top: 30px;
    font-size: 6.5vw;
  }

  .wf-content {
    bottom: 14px;
  }

  .wf-label {
    font-size: 5px;
  }

  .wf-link {
    font-size: 6px;
  }

  .wf-arrow {
    width: 27px;
    height: 27px;

    font-size: 13px;
  }
}
</style>


<!-- CURSOR -->

<div id="wf-dot"></div>
<div id="wf-circle"></div>


<!-- MAIN SECTION -->

<section class="wf-luxury">

  <div class="wf-split">


    <!-- MEN -->

    <a
      href="/collections/men"
      class="wf-panel"
    >

      <img
        src="https://cdn.shopify.com/s/files/1/0906/2835/8514/files/pexels-anna-ginger-2157748733-34952011.jpg?v=1780577945"
        alt="Wildfyre Men Collection"
      >

      <div class="wf-title">
        MEN
      </div>

      <div class="wf-content">

        <div>

          <div class="wf-label">
            SIGNATURE COLLECTION
          </div>

          <div class="wf-link">
            Explore Collection
          </div>

        </div>

        <div class="wf-arrow">
          →
        </div>

      </div>

    </a>


    <!-- WOMEN -->

    <a
      href="/collections/women"
      class="wf-panel"
    >

      <img
        src="https://cdn.shopify.com/s/files/1/0906/2835/8514/files/pexels-petrovskii-anton-123395531-12900452.jpg?v=1780576839"
        alt="Wildfyre Women Collection"
      >

      <div class="wf-title">
        WOMEN
      </div>

      <div class="wf-content">

        <div>

          <div class="wf-label">
            LUXURY COLLECTION
          </div>

          <div class="wf-link">
            Explore Collection
          </div>

        </div>

        <div class="wf-arrow">
          →
        </div>

      </div>

    </a>


    <!-- UNISEX -->

    <a
      href="/collections/unisex"
      class="wf-panel"
    >

      <img
        src="https://cdn.shopify.com/s/files/1/0906/2835/8514/files/pexels-andrea-acosta-1058133719-22805432.jpg?v=1780577158"
        alt="Wildfyre Unisex Collection"
      >

      <div class="wf-title">
        UNISEX
      </div>

      <div class="wf-content">

        <div>

          <div class="wf-label">
            TIMELESS COLLECTION
          </div>

          <div class="wf-link">
            Explore Collection
          </div>

        </div>

        <div class="wf-arrow">
          →
        </div>

      </div>

    </a>


  </div>

</section>


<script>

(function() {

  const dot = document.getElementById("wf-dot");
  const circle = document.getElementById("wf-circle");

  if (window.innerWidth > 768 && dot && circle) {

    let mouseX = 0;
    let mouseY = 0;

    let circleX = 0;
    let circleY = 0;

    document.addEventListener("mousemove", function(e) {

      mouseX = e.clientX;
      mouseY = e.clientY;

      dot.style.left = mouseX + "px";
      dot.style.top = mouseY + "px";

    });

    function animateCursor() {

      circleX += (mouseX - circleX) * 0.15;
      circleY += (mouseY - circleY) * 0.15;

      circle.style.left = circleX + "px";
      circle.style.top = circleY + "px";

      requestAnimationFrame(animateCursor);

    }

    animateCursor();


    document.querySelectorAll(".wf-panel").forEach(function(panel) {

      panel.addEventListener("mouseenter", function() {
        document.body.classList.add("wf-hovering");
      });

      panel.addEventListener("mouseleave", function() {
        document.body.classList.remove("wf-hovering");
      });

    });

  }

})();

</script>